# API — use relative /api so Vite proxy handles CORS
# VITE_API_BASE_URL=/api

# WebSocket — let useWebSocket fall through to window.location.host so the
# Vite /ws proxy (configured in vite.config.ts) handles forwarding to port 8000.
# VITE_WEBSOCKET_URL=ws://localhost:8000

# Map tile config
VITE_MAP_STYLE_URL=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
